# The screens talk to the PostgreSQL server (../server). Its default address is the machine that served this page, port 3000.
# Only set this if the server lives somewhere else:
# VITE_NEW_API_URL=https://api.example.com/api

# Pages whose adapter is written use the new server. Calls the server cannot do yet fail with a clear
# "not available on the new server yet" message. See docs/ROADMAP.md for which pages those are.
VITE_USE_NEW_SERVER=true
