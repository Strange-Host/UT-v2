# The screens talk to the PostgreSQL server (../server). Its default address is the machine that served this page, port 3000.
# Only set this if the server lives somewhere else:
# VITE_NEW_API_URL=https://api.example.com/api

# The screens use the new server by default. Pages whose adapter is written work against it; calls the server cannot do yet
# fail with a clear "not available on the new server yet" message. See docs/ROADMAP.md for which pages those are.
# Only set this to false to point the screens back at the legacy backend:
# VITE_USE_NEW_SERVER=false
